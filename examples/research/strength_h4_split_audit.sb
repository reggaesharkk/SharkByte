// Deterministic SharkByte holdout-split audit for 100 synthetic network IDs.
// Uses a local Park-Miller shuffle; it intentionally does not reproduce
// NumPy default_rng's permutation from the separate H4 Python reference.
// Checks partition size, disjointness, and complete coverage only. It does
// not train/evaluate a detector or establish information gain.

let total = 100;
let train_target = 80;
let ids = array(100);
let seen = array(100);
let i = 0;
while (i < total) {
    ids[i] = i;
    i = i + 1;
}

// Seeded Fisher-Yates shuffle. All products remain within signed i64.
let rng_state = 20261017;
let cursor = 99;
while (cursor > 0) {
    rng_state = rng_state * 48271 % 2147483647;
    let swap_index = rng_state % (cursor + 1);
    let saved_id = ids[cursor];
    ids[cursor] = ids[swap_index];
    ids[swap_index] = saved_id;
    cursor = cursor - 1;
}

let train_count = 0;
let holdout_count = 0;
let duplicate_count = 0;
let position = 0;
while (position < total) {
    let network_id = ids[position];
    if (seen[network_id] == 0) {
        seen[network_id] = 1;
    } else {
        duplicate_count = duplicate_count + 1;
    }

    if (position < train_target) {
        train_count = train_count + 1;
    } else {
        holdout_count = holdout_count + 1;
    }
    position = position + 1;
}

let missing_count = 0;
i = 0;
while (i < total) {
    if (seen[i] == 0) {
        missing_count = missing_count + 1;
    }
    i = i + 1;
}

let split_valid = 0;
if (train_count == 80) {
    if (holdout_count == 20) {
        if (duplicate_count == 0) {
            if (missing_count == 0) {
                split_valid = 1;
            }
        }
    }
}

// Outputs: train rows, holdout rows, duplicates, missing IDs, audit flag.
print train_count;
print holdout_count;
print duplicate_count;
print missing_count;
print split_valid;
