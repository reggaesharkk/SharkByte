quantum phase_flip_recovery {
    qubits 5;
    shots 1024;
    seed 42;

    // Prepare a relative phase of +pi/3 on q0.
    h 0;
    x 3; cp 1.0471975511965976 3 0; x 3;
    cx 0 1; cx 0 2;
    h 0; h 1; h 2;

    // Inject one phase flip. Try z 0, z 2, or omit the error.
    z 1;

    // Rotate into the repetition basis and record the two parities.
    h 0; h 1; h 2;
    cx 0 3; cx 1 3;
    cx 1 4; cx 2 4;

    // BEGIN RECOVERY
    // Syndrome q4 q3 = 01: flip q0.
    x 4;
    h 0; cp 1.5707963267948966 4 0;
    cx 3 4; cp -1.5707963267948966 4 0; cx 3 4;
    cp 1.5707963267948966 3 0; h 0;
    x 4;

    // Syndrome q4 q3 = 11: flip q1.
    h 1; cp 1.5707963267948966 4 1;
    cx 3 4; cp -1.5707963267948966 4 1; cx 3 4;
    cp 1.5707963267948966 3 1; h 1;

    // Syndrome q4 q3 = 10: flip q2.
    x 3;
    h 2; cp 1.5707963267948966 4 2;
    cx 3 4; cp -1.5707963267948966 4 2; cx 3 4;
    cp 1.5707963267948966 3 2; h 2;
    x 3;
    // END RECOVERY

    // Decode. Apply the inverse phase whether q1 is zero or one,
    // so the same readout also works in the recovery-off controls.
    cx 0 2; cx 0 1;
    cp -1.0471975511965976 1 0;
    x 1; cp -1.0471975511965976 1 0; x 1;
    h 0;
    measure_all;
}
